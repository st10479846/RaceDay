@model RaceDay.Mvc.ViewModels.OrganiserDashboardVm
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-primary">My Events Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    @if (Model == null || !Model.Events.Any())
    {
        <div class="col-12 text-center py-5 bg-light rounded shadow-sm">
            <h4 class="text-muted">You haven't created any events yet.</h4>
            <p>Click "Create New Event" to get started!</p>
        </div>
    }
    else
    {
        foreach (var ev in Model.Events)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-0 border-top border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@ev.Title</h5>
                            @if (ev.Status == "Open")
                            {
                                <span class="badge bg-success">Open</span>
                            }
                            else if (ev.Status == "Draft")
                            {

                                <span class="badge bg-secondary">Draft</span>
                            }
                            else
                            {

                                <span class="badge bg-warning text-dark">@ev.Status</span>
                            }
                        </div>

                        <p class="text-muted mb-2"><small>📍 @ev.Location</small></p>
                        <p class="card-text mb-1"><strong>Date:</strong> @ev.StartDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 pt-0 d-flex gap-2">
                        <a asp-action="ManageEvent" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">Manage Event</a>
                    </div>
                </div>
            </div>
        }
    }
</div>