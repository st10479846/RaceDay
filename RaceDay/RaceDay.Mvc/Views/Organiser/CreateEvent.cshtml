@model RaceDay.Contracts.CreateEventRequest
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Create a New Event</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateEvent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Event Name</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Cape Town Marathon" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tell participants about the route, vibe, etc."></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label fw-bold">Start Date & Time</label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label fw-bold">End Date & Time</label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-bold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Durban, KZN" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DistanceKm" class="form-label fw-bold">Distance (km)</label>
                            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Save Event</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>