@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Find Events";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-primary">Upcoming Events</h2>
    <p class="text-muted mb-0">Find your next race and register</p>
</div>

<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5 bg-light rounded shadow-sm">
            <h4 class="text-muted">No upcoming events are currently open for registration.</h4>
            <p>Check back later!</p>
        </div>
    }
    else
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-0 border-top border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-success">@ev.EventType</span>
                            <small class="text-muted">@ev.DistanceKm km</small>
                        </div>
                        
                        <h5 class="card-title fw-bold">@ev.Title</h5>
                        <p class="text-muted mb-2"><small>📍 @ev.Location</small></p>
                        
                        <p class="card-text text-secondary" style="min-height: 4.5em;">
                            @(string.IsNullOrEmpty(ev.Description) ? "No description provided." : ev.Description)
                        </p>
                        
                        <hr />
                        <p class="mb-1"><strong>Date:</strong> @ev.StartDate.ToString("dd MMM yyyy")</p>
                        <p class="mb-0"><strong>Time:</strong> @ev.StartDate.ToString("HH:mm")</p>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3 pt-0">
                        <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100 fw-bold">View Details & Enter</a>
                    </div>
                </div>
            </div>
        }
    }
</div>