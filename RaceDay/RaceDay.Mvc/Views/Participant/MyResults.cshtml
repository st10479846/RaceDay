@model List<RaceDay.Contracts.ResultDto>
@{
    ViewData["Title"] = "My Results";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-success">My Race Results</h2>
    <a asp-action="MyEvents" class="btn btn-outline-secondary">Back to My Events</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Enrolment ID</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                    <th>Age Category</th>
                    <th>Verification</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <h5>You don't have any results captured yet.</h5>
                            <p>Finish a race to see your times here!</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">#@item.EnrolId</td>
                            <td class="align-middle fw-bold text-success fs-5">@item.FinishTime</td>
                            <td class="align-middle fw-bold">@item.Position</td>
                            <td class="align-middle">@item.AgeCategory</td>
                            <td class="align-middle">
                                @if (item.IsVerified)
                                {
                                    <span class="badge bg-success">✔ Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>